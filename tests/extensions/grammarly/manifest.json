{
  "manifest_version": 3,
  "name": "Grammarly",
  "version": "14.1130.0",
  "description": "Grammar checker, writing improvement, and spelling corrector",
  "permissions": [
    "storage",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://*.grammarly.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "grammarly.js"
      ]
    }
  ]
}
