{
  "manifest_version": 3,
  "name": "ColorZilla",
  "version": "4.0.1",
  "description": "Advanced eyedropper, color picker, and gradient generator",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
