{
  "manifest_version": 3,
  "name": "Dark Reader",
  "version": "4.9.96",
  "description": "Dark mode for every website with dynamic style generation",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
