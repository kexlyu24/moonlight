{
  "manifest_version": 3,
  "name": "1Password",
  "version": "2.28.0",
  "description": "Password manager and secure wallet in your browser",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "idle",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
