{
  "manifest_version": 3,
  "name": "JSON Formatter",
  "version": "0.7.3",
  "description": "Makes JSON easy to read with folding, syntax highlighting, and clickable URLs",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "formatter.js"
      ],
      "run_at": "document_end"
    }
  ]
}
